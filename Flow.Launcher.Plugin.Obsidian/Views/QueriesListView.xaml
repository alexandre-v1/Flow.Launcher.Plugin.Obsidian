<UserControl
    x:Class="Flow.Launcher.Plugin.Obsidian.Views.QueriesListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernWpf.Controls;assembly=ModernWpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Flow.Launcher.Plugin.Obsidian.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:QueriesListViewModel}"
    d:DesignWidth="550"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <ItemsControl
            Margin="0"
            Background="Transparent"
            ItemsSource="{Binding Queries}"
            SnapsToDevicePixels="True">

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button HorizontalAlignment="Stretch" Command="{Binding OpenQuerySettingsCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="border"
                                    Width="Auto"
                                    Height="Auto"
                                    Padding="18,12,0,12"
                                    Style="{StaticResource SettingGroupBox}">
                                    <ContentPresenter />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background"
                                                Value="{DynamicResource Color22B}" />
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background"
                                                Value="{DynamicResource Color23B}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" MinWidth="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Column="0"
                                MaxWidth="32"
                                MaxHeight="32"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding Icon, Mode=OneWay, IsAsync=True}" />

                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0,14,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingTitleLabel}"
                                Text="{Binding Name}" />

                            <Button
                                Grid.Column="2"
                                Width="Auto"
                                MinWidth="100"
                                Margin="0,-4.5,14,-4.5"
                                Command="{Binding SetActionKeywordCommand}"
                                Content="{Binding Keyword}"
                                Cursor="Hand"
                                DockPanel.Dock="Right"
                                FontWeight="Bold"
                                ToolTip="{DynamicResource actionKeywordsTooltip}" />

                            <controls:ToggleSwitch
                                x:Name="OnOffControl"
                                Grid.Column="3"
                                Margin="0,0,16,0"
                                IsOn="{Binding IsActive}"
                                OffContent="{DynamicResource disable}"
                                OnContent="{DynamicResource enable}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Padding="0,20" Style="{StaticResource SettingGroupBox}">
            <Grid>
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Color05B}"
                    Text="Create a new query" />

                <Button
                    Width="Auto"
                    MinWidth="100"
                    Margin="20, -4.5"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenQueryCreatorCommand}"
                    Cursor="Hand"
                    Content="Create query"
                    DockPanel.Dock="Right" />

            </Grid>
        </Border>
    </StackPanel>
</UserControl>
